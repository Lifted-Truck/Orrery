#!/usr/bin/env bash
# verify — oracle dispatcher for Orrery. Usage: ./verify fast|full|report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# STAGE O1b (core + plugin):
#   fast → structural scaffold gate + framework-free core build + ctest
#          (shell/core: clock, offset layer, router, trace, determinism) +
#          the core-boundary gate. Offline, quick, no JUCE.
#   full → fast, THEN the JUCE plugin build (shell/plugin) + its ctest
#          (RT no-alloc gate + core-boundary + core tests). Heavier: pulls JUCE
#          via FetchContent (set ORRERY_JUCE_DIR to reuse a cached checkout).
#          The codesign re-seal runs in-build (POST_BUILD); `auval` + install to
#          ~/Library are machine-local / human-run per the global CLAUDE.md
#          build gotchas — see tools/validate_au.sh. Absolute build paths (the
#          CC sandbox resets cwd between calls).
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"; cd "$ROOT"
TARGET="${1:-fast}"; HARNESS_DIR=".harness"; mkdir -p "$HARNESS_DIR"

# Kit-owned gates (kit 2.4.0), vendored + sha256-pinned in .kit/ — `record`,
# `leak_gate`, `kit_integrity`. HARD EXIT if absent: a silently skipped privacy
# gate is the exact bug the gate exists to prevent, so a missing .kit/ must
# never degrade into a green run.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi
BUILD_DIR="$ROOT/build"

# Framework-free core: configure (once), build (absolute path), run ctest.
#
# On FAILURE the tool's own stdout+stderr is replayed IN FULL (from
# .harness/core_build.log); on success it stays quiet. Both streams used to go
# to /dev/null, which in the sibling station reduced a real CI failure to the
# single useless line "cmake configure failed" and cost a local reproduction to
# diagnose (Lathe DECISIONS #16). Do NOT re-silence these.
core_build() {
  local rc=0
  command -v cmake >/dev/null 2>&1 || { echo "verify: cmake not found" >&2; return 1; }
  local log="$HARNESS_DIR/core_build.log"
  # nproc (Linux/CI) first, then macOS sysctl, then 4. sysctl alone silently
  # left CI building at the fallback job count.
  local jobs; jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

  if [ ! -f "$BUILD_DIR/CMakeCache.txt" ]; then
    if ! cmake -S "$ROOT" -B "$BUILD_DIR" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Debug >"$log" 2>&1; then
      echo "verify: cmake configure FAILED — full output follows:" >&2
      cat "$log" >&2
      return 1
    fi
  fi
  if ! cmake --build "$BUILD_DIR" -j"$jobs" >"$log" 2>&1; then
    echo "verify: core build FAILED — full output follows:" >&2
    cat "$log" >&2
    return 1
  fi
  ( cd "$BUILD_DIR" && ctest --output-on-failure ) || rc=1
  return $rc
}

fast() {
  # O0 structural gate: charter + contract + every declared territory present,
  # each engine territory has a sub-charter, manifest is valid JSON.
  local ok=0
  # Kit-owned gates first: .kit/ integrity (are the vendored gates the pinned
  # ones?) then the privacy/leak gate. Both are advisory-to-ok so every project
  # gate below still RUNS and reports — we want the full picture, not first-fail.
  kit_integrity || ok=1
  leak_gate     || ok=1
  for f in CLAUDE.md ROADMAP.md DECISIONS.md project.manifest.json \
           sequencer-studio-architecture.md; do
    [ -f "$f" ] || { echo "verify: missing $f" >&2; ok=1; }
  done
  python3 -c "import json;json.load(open('project.manifest.json'))" 2>/dev/null \
    || { echo "verify: manifest is not valid JSON" >&2; ok=1; }
  # every territory in the manifest exists + has a sub-charter; AND every dir
  # under engines/ is registered (intake safety net — new engines land there).
  python3 - <<'PY' || ok=1
import json,os,sys
m=json.load(open("project.manifest.json"))
bad=0
registered={t["path"] for t in m["composite"]["territories"]}
for t in m["composite"]["territories"]:
    p=t["path"]
    if not os.path.isdir(p): print(f"verify: territory dir missing: {p}"); bad=1
    if not os.path.isfile(os.path.join(p,"CLAUDE.md")): print(f"verify: territory sub-charter missing: {p}/CLAUDE.md"); bad=1
    spec=t.get("spec")
    if spec and not os.path.isfile(os.path.join(p,spec)): print(f"verify: declared spec missing: {p}/{spec}"); bad=1
# every engines/<name> (except the _template) must be a registered territory
edir=m["composite"].get("engines_dir","engines")
if os.path.isdir(edir):
    for name in sorted(os.listdir(edir)):
        path=os.path.join(edir,name)
        if not os.path.isdir(path) or name.startswith((".","_")):
            continue
        if path not in registered:
            print(f"verify: UNREGISTERED engine '{path}' — add it to "
                  f"project.manifest.json composite.territories + a CLAUDE.md "
                  f"(copy {edir}/_template/)"); bad=1
sys.exit(bad)
PY
  if [ $ok -ne 0 ]; then return $ok; fi
  echo "verify: scaffold structurally coherent"
  # O1 build gate: framework-free core builds + all ctests pass.
  core_build || return 1
  echo "verify[fast]: core build + ctest green (O1)"
  return 0
}

# O1b plugin build gate: JUCE VST3/AU/Standalone + RT no-alloc + all ctests.
full() {
  fast || return 1
  command -v cmake >/dev/null 2>&1 || { echo "verify: cmake not found" >&2; return 1; }
  local PBUILD="$ROOT/build-plugin"
  local extra=()
  [ -n "${ORRERY_JUCE_DIR:-}" ] && extra+=("-DFETCHCONTENT_SOURCE_DIR_JUCE=$ORRERY_JUCE_DIR")
  if [ ! -f "$PBUILD/CMakeCache.txt" ]; then
    cmake -S "$ROOT" -B "$PBUILD" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Debug \
      -DORRERY_BUILD_PLUGIN=ON "${extra[@]}" \
      || { echo "verify: plugin configure failed (JUCE fetch?)" >&2; return 1; }
  fi
  cmake --build "$PBUILD" -j"$(sysctl -n hw.ncpu 2>/dev/null || echo 4)" \
    || { echo "verify: plugin build failed" >&2; return 1; }
  ( cd "$PBUILD" && ctest --output-on-failure ) || return 1
  echo "verify[full]: plugin build + RT/boundary/core ctests green (O1b)."
  echo "  note: auval + install to ~/Library are human-run (tools/validate_au.sh)."
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
